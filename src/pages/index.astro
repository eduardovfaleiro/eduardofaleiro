---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { selectPublished } from '../lib/posts';

const posts = selectPublished(await getCollection('blog'), import.meta.env.DEV);
const recent = posts.slice(0, 5);
---

<Base
  title="Eduardo Faleiro"
  description="Personal site of Eduardo Faleiro — software engineer working on database performance and APIs for mission-critical systems."
>
  <section class="intro prose">
    <h1>Eduardo Faleiro</h1>
    <p>
      Software engineer focused on database performance and APIs for
      mission-critical systems. I work mostly with PostgreSQL, Python/FastAPI,
      Java/Spring Boot and Kotlin, and I write here about making systems faster.
    </p>
    <SocialLinks />
  </section>

  <section class="recent">
    <h2>Recent posts</h2>
    {recent.length === 0 && <p>No posts yet.</p>}
    {recent.map((post) => <PostCard post={post} />)}
    {posts.length > recent.length && <p><a href="/blog">All posts</a></p>}
  </section>
</Base>

<style>
  .intro {
    margin-bottom: calc(3 * var(--space));
  }

  .recent h2 {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--fg-muted);
  }
</style>
