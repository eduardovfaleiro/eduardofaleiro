---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import { LOCALES } from '../lib/posts';

interface Props {
  post: CollectionEntry<'blog'>;
  /** URL da tradução deste post, quando ela existe. */
  translationHref?: string;
}

const { post, translationHref } = Astro.props;
const lang = post.data.lang;

const format = (date: Date) =>
  date.toLocaleDateString(LOCALES[lang], {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });

const updatedLabel = lang === 'pt' ? 'atualizado em' : 'updated';
---

<Base
  title={`${post.data.title} — Eduardo Faleiro`}
  description={post.data.description}
  ogImage={post.data.heroImage}
  lang={lang}
  translationHref={translationHref}
>
  <article class="prose">
    <h1>{post.data.title}</h1>

    <p class="meta">
      <time datetime={post.data.pubDate.toISOString()}>{format(post.data.pubDate)}</time>
      {post.data.updatedDate && <span> · {updatedLabel} {format(post.data.updatedDate)}</span>}
      {post.data.tags.length > 0 && <span> · {post.data.tags.join(', ')}</span>}
    </p>

    {post.data.heroImage && <img src={post.data.heroImage} alt="" />}

    <slot />
  </article>
</Base>

<style>
  .meta {
    margin-top: -0.5rem;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
</style>
